{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-trading-desk",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "triggers": {
    "crons": ["*/15 * * * 1-5"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trading-desk-db",
      "database_id": "871646f0-3533-4d8b-9e4d-7d7bc13495db",
      "migrations_dir": "migrations"
    }
  ]
}
