{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-trading-desk",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "triggers": {
    "crons": ["*/15 * * * 1-5"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "trading-desk-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
